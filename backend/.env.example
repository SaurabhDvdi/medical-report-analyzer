# ==============================================================================
# Medical Report Analyzer - Backend Environment Configuration Example
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# ── General & Server Environment ──────────────────────────────────────────────
ENVIRONMENT=development                # development | staging | production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Authentication & Security ─────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-256bit-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database Configuration ───────────────────────────────────────────────────
# If DATABASE_URL is set, it overrides DB_* individual fields.
# For local dev without MySQL, leaves blank to automatically fallback to SQLite.
# For Docker/Kubernetes, use: mysql+pymysql://medical_user:medical_password@mysql:3306/medical_report_analysis
DATABASE_URL=
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medical_report_analysis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis & Background Worker Queue ──────────────────────────────────────────
# Set ASYNC_PROCESSING_ENABLED=true in production/Docker/K8s to delegate OCR to worker.
ASYNC_PROCESSING_ENABLED=false
REDIS_URL=redis://localhost:6379/0      # In Docker: redis://redis:6379/0

# ── Storage Service Configuration ────────────────────────────────────────────
# STORAGE_BACKEND: local (persistent volume / local dir) or s3 (cloud object storage)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
S3_ENDPOINT_URL=
S3_BUCKET_NAME=medical-reports-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ── OCR & Document Processing ────────────────────────────────────────────────
# Windows only: Path to Poppler bin directory. In Linux/Docker, installed via apt.
POPPLER_PATH=C:/poppler/Library/bin

# ── LLM Inference Provider ───────────────────────────────────────────────────
# Active provider: "ollama" (Local/Docker), "gemini" (Google Cloud), or "groq" (Cloud)
LLM_PROVIDER=ollama

# Ollama Configuration (Local / Container)
# NOTE: Use http://ollama:11434 inside Docker/Kubernetes container networks.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_THREADS=8

# Google Gemini Cloud Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud Configuration (Optional)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# ── AI Inference Bounds & Generation Controls ────────────────────────────────
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=160
AI_TIMEOUT_SECONDS=30.0
BOUNDED_CONTEXT_TOKENS=350
MAX_MODEL_ATTEMPTS=2
MAX_CHAT_INPUT_LENGTH=1000
RATE_LIMIT_AI_PER_MINUTE=30
RAG_COLLECTION_NAME=medical_reports_knowledge

# ── TypeSafe Jev System-1 Triage Configuration ────────────────────────────────
JEV_ENABLED=true
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_INTENT_CONFIDENCE_THRESHOLD=0.60
JEV_TOOL_CONFIDENCE_THRESHOLD=0.70
JEV_TOOL_CONFIDENCE_HIGH=0.70
JEV_TOOL_CONFIDENCE_MEDIUM=0.40
JEV_EMERGENCY_THRESHOLD=0.85
JEV_MEDICATION_THRESHOLD=0.80
JEV_TIMEOUT_MS=1500
EMERGENCY_CONTACT_LABEL=your local emergency services (e.g. 911, 112, or local emergency hospital)
