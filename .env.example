# ==============================================================================
# Medical Report Analyzer - Docker Compose Environment Configuration
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

ENVIRONMENT=development

# MySQL Database
DB_NAME=medical_report_analysis
DB_USER=medical_user
DB_PASSWORD=medical_secure_password_123!
MYSQL_ROOT_PASSWORD=root_secure_password_123!

# JWT Secret Key
SECRET_KEY=change-this-in-production-to-a-secure-random-256bit-string

# Redis
REDIS_URL=redis://redis:6379/0
ASYNC_PROCESSING_ENABLED=true

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/uploads

# Ollama In-Cluster Networking
OLLAMA_BASE_URL=http://ollama:11434
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_THREADS=8

# Cloud LLM Fallbacks (Optional)
GROQ_API_KEY=
GEMINI_API_KEY=
TYPESAFE_API_KEY=
